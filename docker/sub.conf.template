# Публичный вход для ссылки-подписки. Рендерится docker-entrypoint.sh, когда
# задан SUB_TLS_PORT; порт слушает только этот server, остальное — 404.
server {
  listen __SUB_TLS_PORT__ ssl;
  http2 on;
  ssl_protocols TLSv1.2 TLSv1.3;
  # Origin-сертификат Cloudflare (*.enkeym.site): его проверяет только сам
  # Cloudflare, браузер напрямую увидит предупреждение о самоподписи.
  ssl_certificate     /app/configs/cloudflare-cert.pem;
  ssl_certificate_key /app/configs/cloudflare-key.pem;

  server_name __SUB_HOST__;
  access_log off;
  client_max_body_size 0;

  location /sub/ {
    proxy_pass http://127.0.0.1:__APP_PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / { return 404; }
}
