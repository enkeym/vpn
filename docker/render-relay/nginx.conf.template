map $http_upgrade $relay_connection {
  default upgrade;
  ''      close;
}

server {
  listen ${PORT};
  server_name _;

  location = /__health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location / {
    proxy_pass https://${ORIGIN_ADDR}:443;

    # TLS до origin терминируется отдельно от TLS клиента: Render закрывает
    # клиентский сегмент своим сертификатом, здесь мы поднимаем свой к origin
    # с SNI домена CDN — по нему разводчик на origin выбирает нужную ветку.
    proxy_ssl_server_name on;
    proxy_ssl_name ${ORIGIN_SNI};
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $relay_connection;
    proxy_set_header Host ${ORIGIN_SNI};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # VPN-соединение живёт часами: без этого буферизация копит пакеты,
    # а таймаут рвёт туннель раньше, чем клиент.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
