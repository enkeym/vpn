DATABASE_URL="./data/vpn.db"
PORT=3000

TELEGRAM_BOT_TOKEN= # Можно получить в @BotFather
TELEGRAM_ALLOWED_IDS= # 12345678,87654321 Добавь свой telegramId @Getmyid_bot

WG_ADDRESS= # 10.0.0
WG_DNS=1.1.1.1,8.8.8.8
WG_MTU= # 1420 шина приема
WG_ALLOWED_IPS= # 0.0.0.0/0,::/0
WG_HOST= # 11.111.111.111
WG_PORT= # внутрь требуется 443
WG_CONF_PATH= # путь для конфигов

# VLESS + XTLS-Reality (Xray)
XRAY_PORT= # 443 (TCP), не конфликтует с WG_PORT на UDP
XRAY_REALITY_DEST= # www.microsoft.com:443 — реальный сайт-маска (TLS 1.3, вне РФ)
XRAY_REALITY_SNI= # www.microsoft.com — SNI, который видит DPI (домен из DEST)

# Лимит устройств на один конфиг. Режим наблюдения: превышение логируется и
# владелец получает уведомление, доступ НЕ ограничивается (см. DeviceLimitService).
DEVICE_LIMIT_ENABLED=true
DEVICE_LIMIT_MAX_DEVICES=2
DEVICE_LIMIT_WHITELIST_CIDRS= # подсети-исключения через запятую, напр. 203.0.113.0/24

YOOKASSA_SHOP_ID=#ваш_id
YOOKASSA_SECRET_KEY=#ваш_ключ
TELEGRAM_BOT_USERNAME=tunelvpnbot # без @
INTERNAL_METRICS_KEY= # ключ для доступа к метрикам

# true — все платежи в ЮKassa на 1 ₽; доступен POST /payment/test/complete-succeeded (имитация успеха без вебхука)
TEST_PAYMENT=false

# false — скрывает кнопку «Получить VPN» (оплату) у обычных пользователей в главном меню
PAYMENT=true