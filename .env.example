DATABASE_URL="./sqlite.db"
PORT=3000

TELEGRAM_BOT_TOKEN= # Можно получить в @BotFather
TELEGRAM_ALLOWED_IDS= # 12345678,87654321 Добавь свой telegramId @Getmyid_bot

# === AmneziaWG (единственный туннель, интерфейс awg0) ===
# Поднимается автоматически, если в образе есть awg/awg-quick/amneziawg-go.
WG_HOST= # 11.111.111.111 — адрес сервера в Endpoint клиентского конфига
AWG_ENABLED=true # false — не поднимать awg0; бот тогда не сможет выдавать конфиги
AWG_PORT=51821 # UDP-порт, на котором awg0 слушает внутри контейнера
AWG_PUBLIC_PORT=4500 # порт в Endpoint клиентского конфига и в проброске docker.
        # Отделён от AWG_PORT намеренно: мобильные операторы режут нестандартные
        # UDP-порты, а 4500/udp (IPsec NAT-T) пропускают везде. Должен быть открыт
        # в фаерволе VPS. Не задан — совпадает с AWG_PORT.
AWG_LEGACY_PUBLIC_PORTS= # 4500, 51821 — порты прежних редакций AWG_PUBLIC_PORT.
        # Смена AWG_PUBLIC_PORT не перевыпускает уже скачанные конфиги: они
        # остаются со старым Endpoint. Перечислите здесь старые порты, и REDIRECT
        # для них будет держаться наравне с текущим, а не жить на хосте сиротой
        # до первой перезагрузки. Не забудьте открыть их в фаерволе VPS.
AWG_ADDRESS=10.9.0.1/16 # подсеть туннеля
AWG_ADDRESS6=fd42:9::1/64 # IPv6-подсеть туннеля (ULA). Без неё клиент забирает
        # «::/0» из AllowedIPs, но выпустить IPv6-пакеты ему некуда — они молча
        # пропадают, и дуалстек-сайты висят до таймаута Happy Eyeballs. Адрес
        # клиента считается из его IPv4 (10.9.0.2 → fd42:9::2). Требует sysctls
        # net.ipv6.conf.all.{disable_ipv6=0,forwarding=1} в docker-compose.yml.
        # Пустое значение полностью выключает IPv6 в туннеле.
AWG_MTU=1280 # минимум для IPv6; junk-пакеты увеличивают размер, запас под мобильные сети
AWG_DNS= # 1.1.1.1, 8.8.8.8 — только IPv4-резолверы: IPv6 в туннель не заворачивается
AWG_ALLOWED_IPS= # 0.0.0.0/0, ::/0 по умолчанию — строка сравнивается AmneziaVPN
        # буквально, и без неё клиент блокирует раздельное туннелирование.
        # Менять только вместе с проверкой в клиенте.

# Параметры обфускации. Если не заданы — генерируются один раз при создании
# configs/awg0.conf (уникальные для сервера — так лучше против DPI).
# Задавать нужно ЛИБО все одиннадцать, ЛИБО ни одного. Ограничения:
# AWG_S1 + 56 != AWG_S2, диапазоны AWG_H1..AWG_H4 не пересекаются и больше 4.
AWG_JC= # кол-во мусорных пакетов, рекомендуется 4..12
AWG_JMIN= # мин. размер мусорного пакета
AWG_JMAX= # макс. размер мусорного пакета (<= 1280)
AWG_S1= # добивка init-пакета хендшейка
AWG_S2= # добивка response-пакета хендшейка
AWG_S3= # добивка cookie-пакета (AWG 3)
AWG_S4= # добивка КАЖДОГО транспортного пакета (AWG 3), держите в 0..64
AWG_H1= # типы заголовков: число или диапазон вида 100000-200000 (AWG 3)
AWG_H2=
AWG_H3=
AWG_H4=

# === AmneziaWG 3 ===
# Поддерживается только формат AWG 3. Клиенты: AmneziaVPN >= 5.0.0.5 или
# AmneziaWG >= 3.0.1 — более старые не подключатся вообще.

# Конфиг, созданный до AWG 3 (без S3/S4, header protection и диапазонов
# H1..H4), дозаполняется до полного формата только при true: правка меняет
# параметры обфускации и разом отключает всех, кому конфиг уже выдан.
# По умолчанию — только предупреждение в логах.
AWG_ALLOW_CONFIG_UPGRADE=false

# Header protection — шифрование заголовков, единственный параметр AWG 3,
# который обязан совпадать на сервере и клиенте. Ключ генерируется сам при
# создании awg0.conf.
# ⚠️ AmneziaVPN при импорте .conf-файла ОТБРАСЫВАЕТ HeaderProtectionKey
# (importController.cpp переносит только Jc/Jmin/Jmax/S1..S4/H1..H4/I1..I5) —
# клиент подключается без шифрования заголовков и виснет на хендшейке.
# Включать только если все клиенты используют приложение AmneziaWG >= 3.0.1,
# которое передаёт .conf в туннель как есть.
AWG_HEADER_PROTECTION=false
AWG_HEADER_PROTECTION_KEY= # свой ключ (base64, 32 байта) вместо сгенерированного

# Ниже — client-side: расхождение с сервером хендшейк не ломает.
AWG_CONTENT_PADDING= # случайная набивка данных, диапазон: 1-32
AWG_PERSISTENT_KEEPALIVE=25 # секунды; можно диапазон 22-30 — ровный интервал тоже сигнатура

# Тайминги WireGuard в секундах, тоже диапазонами. Пустые — значения по
# умолчанию из протокола; неверные значения рвут соединение, трогать осознанно.
AWG_REKEY_AFTER_TIME=
AWG_REKEY_TIMEOUT=
AWG_REJECT_AFTER_TIME=
AWG_KEEPALIVE_TIMEOUT=
AWG_MAX_HANDSHAKE_ATTEMPTS=

# Пакеты-имитации чужих протоколов (DNS, QUIC, SIP), отправляются перед каждым
# хендшейком в порядке I1..I5. Синтаксис тегов: <b 0x...>, <r N>, <rd N>, <rc N>, <t>.
# J1..J3 и Itime из версии 1.5 удалены — amneziawg-tools их больше не разбирает.
# Без I1 мобильные операторы режут хендшейк по сигнатуре (на Wi‑Fi при этом
# всё работает) — рабочее значение (имитация QUIC) см. docs.amnezia.org →
# troubleshooting/self-hosted-amneziawg-not-working, «Changing the Signature».
# Протокол имитации подбирать под AWG_PUBLIC_PORT: QUIC — к 443, DNS — к 53.
# Пример DNS-запроса A yandex.ru (кавычки не нужны — env_file их не снимает):
# AWG_I1=<r 2><b 0x010000010000000000000679616e6465780272750000010001>
# Применяются и к уже существующему awg0.conf: недостающие дописываются,
# отличающиеся заменяются. После смены конфиг нужно заново скачать из бота.
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

# === VLESS (Xray) — второй канал доступа рядом с AmneziaWG ===
# Тот же конфиг выдаётся двумя способами: .conf для AmneziaVPN и VLESS-ссылки.
# Протоколы блокируются по-разному — клиент подключается тем, что живо на сети.
# Xray поднимается сам, если в образе есть бинарник xray и задан WG_HOST.
XRAY_ENABLED=true # false — не запускать Xray; бот покажет только канал AmneziaWG
XRAY_HOST= # адрес в Reality-ссылке. Пусто — берётся WG_HOST

# --- Канал 1: Reality (прямой TCP на IP сервера, без CDN) ---
# Публичный порт узла. С заданным XRAY_DOMAIN его слушает nginx и разводит по
# SNI: домен → CDN-канал, всё остальное → Reality. Без домена Xray слушает его
# сам. 443/tcp закреплён за этим каналом — TLS на нестандартном порту для DPI
# отдельный маркер, Xray прямо предупреждает об этом при старте. Открыть в
# фаерволе VPS.
XRAY_REALITY_PORT=443
XRAY_REALITY_DEST=www.wikipedia.org:443 # реальный сайт-маска (TLS 1.3, вне РФ)
XRAY_REALITY_SNI=www.wikipedia.org # SNI, который видит DPI (домен из DEST)
        # Домен-маску берите там же, где хостится сервер: TLS-сессия из РФ в
        # европейский датацентр с SNI российского сайта — заметная аномалия.
        # Надёжнее self-steal: свой поддомен (DNS only) как SNI, DEST —
        # 127.0.0.1:XRAY_INTERNAL_STEAL_PORT (сайт-маску отдаёт nginx).
XRAY_REALITY_EXTRA_SNI= # прежние SNI через запятую — после смены SNI, чтобы выданные vless:// не умерли
XRAY_INTERNAL_STEAL_PORT= # 8446 — self-steal сайт-маска nginx на localhost; нужен XRAY_DOMAIN
        # и сертификат домена из XRAY_REALITY_SNI в configs/steal-cert.pem + steal-key.pem

# --- Канал 2: VLESS+WS+TLS за Cloudflare CDN (опционально) ---
# Пусто — канал не поднимается, остаётся только Reality, а ссылка-подписка
# (/sub) не выдаётся: публиковать её негде; nginx тогда тоже не запускается.
# Заданный домен ВКЛЮЧАЕТ разводчик: nginx слушает XRAY_REALITY_PORT и по SNI
# отправляет этот домен на свой TLS-сервер, а всё остальное — в Reality.
# Требуется: домен за Cloudflare (проксирование включено, оранжевое облако) и
# сертификат Cloudflare Origin CA в configs/cloudflare-cert.pem + -key.pem.
XRAY_DOMAIN= # cdn.example.com
XRAY_PORT=443 # порт CDN-канала в ссылках; должен совпадать с XRAY_REALITY_PORT,
        # потому что оба канала обслуживает один nginx на одном порту
XRAY_INTERNAL_WS_PORT=8880 # WS-инбаунд на localhost, наружу не публикуется
XRAY_INTERNAL_REALITY_PORT=8444 # Reality за nginx, localhost
NGINX_INTERNAL_TLS_PORT=8445 # TLS-сервер nginx на localhost (CDN-ветка разводчика)
XRAY_STATS_API_PORT=8881 # API Xray на localhost (статистика + adu/rmu)

# IPv6 наружу через Xray. true — домены резолвятся и в A, и в AAAA (приоритет
# у IPv4), ресурсы только с IPv6 доступны. Ставить false, если у VPS пропал
# исходящий IPv6: иначе дуалстек-домены виснут на таймауте Happy Eyeballs.
# На AmneziaWG не влияет — там свои AWG_ADDRESS6/AWG_DNS.
XRAY_IPV6=true

YOOKASSA_SHOP_ID=#ваш_id
YOOKASSA_SECRET_KEY=#ваш_ключ
TELEGRAM_BOT_USERNAME=tunelvpnbot # без @
INTERNAL_METRICS_KEY= # ключ для доступа к метрикам

# Число доверенных обратных прокси перед приложением (Express `trust proxy`).
# 1 — один nginx/caddy. От этого зависит корректность req.ip, по которому
# проверяется IP-allow-list вебхука ЮKassa. Ставить больше 1 только если хопов
# реально несколько — лишний хоп снова делает req.ip подделываемым.
TRUST_PROXY_HOPS=1

# true — тестовый режим оплаты: у АДМИНОВ (TELEGRAM_ALLOWED_IDS) «Получить доступ» ведёт в тарифы
# с ценой 1 ₽ вместо бесплатного создания конфига — так проверяется весь клиентский путь.
# Обычные клиенты платят полную цену, «Семья» не затрагивается.
# Также доступен POST /payment/test/complete-succeeded (имитация успеха без вебхука).
# Подрежим приёма оплаты: при выключенном приёме (HIDE_USER_PAYMENT_MENU=true или
# «Оплата: ВЫКЛ» в «Параметрах») тестовая оплата считается выключенной, что бы здесь ни стояло.
# Дефолт стартовых значений; переключается в «Параметрах» админ-панели без рестарта.
TEST_PAYMENT=false

# true — скрыть меню оплаты (и кнопку «Получить доступ») для обычных пользователей. Админов и «Семью» не затрагивает.
HIDE_USER_PAYMENT_MENU=false
