DATABASE_URL="./sqlite.db"
PORT=3000
HTTP_HOST=127.0.0.1

# Комментарий у ПУСТОГО значения — только строкой выше: docker compose читает
# `KEY= # текст` как значение «# текст». У непустых (`KEY=443 # текст`) можно в строке.

# Можно получить в @BotFather
TELEGRAM_BOT_TOKEN=
# 12345678,87654321 Добавь свой telegramId @Getmyid_bot
TELEGRAM_ALLOWED_IDS=

# === AmneziaWG (единственный туннель, интерфейс awg0) ===
# Поднимается автоматически, если в образе есть awg/awg-quick/amneziawg-go.
# vpn.example.com — домен (или IP) сервера в Endpoint клиентского конфига.
# Домен с A-записью, которую ведёт CF_DNS_RECORDS, переживает бан IP:
# выданные конфиги не надо перевыпускать. Серое облако Cloudflare.
WG_HOST=
# 157.228.112.30 — IP, с которого трафик выходит наружу. На старте
# адрес вешается на внешний интерфейс (ip addr add), а вместо MASQUERADE
# ставится SNAT на него первым в POSTROUTING: MASQUERADE берёт первый адрес
# интерфейса, и после бана IP трафик продолжал бы идти со старого. Смена
# значения + перезапуск контейнера; адрес при остановке не снимается.
# Нужны NET_ADMIN и network_mode: host. Пусто — всё как раньше.
# Уже выданные конфиги несут старый IP в Endpoint — их придётся перевыпустить.
PUBLIC_IPV4=
# Токен Cloudflare с правом DNS:Edit на зону. Пусто — синхронизация DNS выключена.
# На старте A-записи из CF_DNS_RECORDS переписываются на PUBLIC_IPV4
# (только если адрес подтверждённо повешен на интерфейс).
CF_API_TOKEN=
# ID зоны (Cloudflare → Overview → API)
CF_ZONE_ID=
# vpn.example.com, r.example.com — имена прямых A-записей через запятую
CF_DNS_RECORDS=
AWG_ENABLED=true # false — не поднимать awg0; бот тогда не сможет выдавать конфиги
AWG_PORT=5667 # UDP-порт, на котором awg0 слушает внутри контейнера
AWG_ADDRESS=10.9.0.1/16 # подсеть туннеля
AWG_ADDRESS6=
AWG_MTU=1280
AWG_TCP_MSS=0
# 1.1.1.1, 8.8.8.8 — только IPv4-резолверы: IPv6 в туннель не заворачивается
AWG_DNS=149.112.112.112, 8.8.4.4
AWG_ALLOWED_IPS=0.0.0.0/0, ::/0

# Параметры обфускации. Если не заданы — генерируются один раз при создании
# configs/awg0.conf (уникальные для сервера — так лучше против DPI).
# Задавать нужно ЛИБО все одиннадцать, ЛИБО ни одного. Ограничения:
# AWG_S1 + 56 != AWG_S2, диапазоны AWG_H1..AWG_H4 не пересекаются и больше 4.
# AWG_JC — кол-во мусорных пакетов, рекомендуется 4..12
# AWG_JMIN / AWG_JMAX — мин. и макс. размер мусорного пакета (JMAX <= 1280)
# AWG_S1 / AWG_S2 — добивка init- и response-пакета хендшейка
# AWG_S3 — добивка cookie-пакета (AWG 3)
# AWG_S4 — добивка КАЖДОГО транспортного пакета (AWG 3), держите в 0..64
# AWG_H1..AWG_H4 — типы заголовков: число или диапазон вида 100000-200000 (AWG 3)
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=

# === AmneziaWG 3 ===
# Поддерживается только формат AWG 3. Клиенты: AmneziaVPN >= 5.0.0.5 или
# AmneziaWG >= 3.0.1 — более старые не подключатся вообще.

# Header protection — шифрование заголовков, единственный параметр AWG 3,
# который обязан совпадать на сервере и клиенте. Ключ генерируется сам при
# создании awg0.conf.
# ⚠️ AmneziaVPN при импорте .conf-файла ОТБРАСЫВАЕТ HeaderProtectionKey
# (importController.cpp переносит только Jc/Jmin/Jmax/S1..S4/H1..H4/I1..I5) —
# клиент подключается без шифрования заголовков и виснет на хендшейке.
# Включать только если все клиенты используют приложение AmneziaWG >= 3.0.1,
# которое передаёт .conf в туннель как есть.
AWG_HEADER_PROTECTION=false
# Свой ключ (base64, 32 байта) вместо сгенерированного
AWG_HEADER_PROTECTION_KEY=

# Ниже — client-side: расхождение с сервером хендшейк не ломает.
# Случайная набивка данных, диапазон: 1-32
AWG_CONTENT_PADDING=10-100
AWG_PERSISTENT_KEEPALIVE=25-35

# Тайминги WireGuard в секундах, тоже диапазонами. Пустые — значения по
# умолчанию из протокола; неверные значения рвут соединение, трогать осознанно.
AWG_REKEY_AFTER_TIME=100-120
AWG_REKEY_TIMEOUT=3-8
AWG_REJECT_AFTER_TIME=150-180
AWG_KEEPALIVE_TIMEOUT=7-13
AWG_MAX_HANDSHAKE_ATTEMPTS=15-20
AWG_RANDOM_TRAILERS=off
AWG_DISABLE_COOKIES=off

# Пакеты-имитации чужих протоколов (DNS, QUIC, SIP), отправляются перед каждым
# хендшейком в порядке I1..I5. Синтаксис тегов: <b 0x...>, <r N>, <rd N>, <rc N>, <t>.
# J1..J3 и Itime из версии 1.5 удалены — amneziawg-tools их больше не разбирает.
# Без I1 мобильные операторы режут хендшейк по сигнатуре (на Wi‑Fi при этом
# всё работает) — рабочее значение (имитация QUIC) см. docs.amnezia.org →
# troubleshooting/self-hosted-amneziawg-not-working, «Changing the Signature».
# Пример DNS-запроса A yandex.ru (кавычки не нужны — env_file их не снимает):
# AWG_I1=<r 2><b 0x010000010000000000000679616e6465780272750000010001>
# Применяются и к уже существующему awg0.conf: недостающие дописываются,
# отличающиеся заменяются. После смены конфиг нужно заново скачать из бота.
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

XRAY_ENABLED=false # false — не запускать Xray; бот покажет только канал AmneziaWG

XRAY_REALITY_PORT=443
XRAY_REALITY_DEST=www.wikipedia.org:443 # реальный сайт-маска (TLS 1.3, вне РФ)
XRAY_REALITY_SNI=www.wikipedia.org # SNI, который видит DPI (домен из DEST)
        # Домен-маску берите там же, где хостится сервер: TLS-сессия из РФ в
        # европейский датацентр с SNI российского сайта — заметная аномалия.
        # Надёжнее self-steal: свой поддомен (DNS only) как SNI, DEST —
        # 127.0.0.1:XRAY_INTERNAL_STEAL_PORT (сайт-маску отдаёт nginx).
XRAY_INTERNAL_STEAL_PORT=

XRAY_INTERNAL_REALITY_PORT=8444 # Reality за nginx, localhost
XRAY_STATS_API_PORT=8881 # API Xray на localhost (статистика + adu/rmu)

# Дополнительные Reality-каналы: gRPC и XHTTP. Оба доступны по TCP на своих
# портах и переиспользуют ключи/SNI канала Reality — меняется только транспорт.
# Свежие клиенты (Happ, Hiddify, v2rayNG, sing-box) держат XHTTP, gRPC
# совместим шире; TCP+Reality оставлен как fallback с дроблением ClientHello.
XRAY_GRPC_PORT=27443
XRAY_GRPC_SERVICE=grpc-vk # имя gRPC-сервиса, должно совпадать в ссылке и конфиге
XRAY_XHTTP_PORT=27444
XRAY_XHTTP_PATH=/xhttp # замените на случайный путь: /<8-16 символов>
XRAY_XHTTP_MODE=auto # auto | packet-up | stream-up | stream-one

XRAY_WS_HOST=
XRAY_WS_PORT=8002
XRAY_WS_PATH=/ws

XRAY_CDN_XHTTP_HOST=
XRAY_CDN_XHTTP_PORT=8003
XRAY_CDN_XHTTP_PATH=

HY2_ENABLED=true
HY2_PORT=443
HY2_SNI=
HY2_STATS_PORT=9999
HY2_OBFS=true
HY2_CERT=
HY2_KEY=
# false — сервер работает, но hysteria2 прячется из подписки/бота (HY2_ENABLED
# при этом не трогаем): канал живёт для тех сетей, где UDP реально проходит.
HY2_SHARE_LINKS=true

# Публичный HTTPS-адрес приложения (reverse proxy на PORT) — из него бот
# собирает ссылку-подписку /sub/<uuid>. Без него кнопка «Одна ссылка — все
# протоколы» сообщит, что ссылка недоступна, а прямые vless:// останутся.
SUB_PUBLIC_URL=

# Порт, на котором nginx отдаёт /sub наружу по TLS с origin-сертификатом
# Cloudflare (*.enkeym.site). Нужен, чтобы Cloudflare в режиме Full (strict)
# забрал подписку с 443. Пусто — публичного входа нет.
SUB_TLS_PORT=
SUB_HOST= # поддомен из SUB_PUBLIC_URL, например sub.example.com

# IPv6 наружу через Xray. true — домены резолвятся и в A, и в AAAA (приоритет
# у IPv4), ресурсы только с IPv6 доступны. Ставить false, если у VPS пропал
# исходящий IPv6: иначе дуалстек-домены виснут на таймауте Happy Eyeballs.
# На AmneziaWG не влияет — там свои AWG_ADDRESS6/AWG_DNS.
XRAY_IPV6=true

# ID магазина и секретный ключ ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_BOT_USERNAME=tunelvpnbot # без @
# Ключ для доступа к метрикам
INTERNAL_METRICS_KEY=

# Число доверенных обратных прокси перед приложением (Express `trust proxy`).
# 1 — один nginx/caddy. От этого зависит корректность req.ip, по которому
# проверяется IP-allow-list вебхука ЮKassa. Ставить больше 1 только если хопов
# реально несколько — лишний хоп снова делает req.ip подделываемым.
TRUST_PROXY_HOPS=1

# true — тестовый режим оплаты: у АДМИНОВ (TELEGRAM_ALLOWED_IDS) «Получить доступ» ведёт в тарифы
# с ценой 1 ₽ вместо бесплатного создания конфига — так проверяется весь клиентский путь.
# Обычные клиенты платят полную цену, «Семья» не затрагивается.
# Также доступен POST /payment/test/complete-succeeded (имитация успеха без вебхука).
# Подрежим приёма оплаты: при выключенном приёме (HIDE_USER_PAYMENT_MENU=true или
# «Оплата: ВЫКЛ» в «Параметрах») тестовая оплата считается выключенной, что бы здесь ни стояло.
# Дефолт стартовых значений; переключается в «Параметрах» админ-панели без рестарта.
TEST_PAYMENT=false

# true — скрыть меню оплаты (и кнопку «Получить доступ») для обычных пользователей. Админов и «Семью» не затрагивает.
HIDE_USER_PAYMENT_MENU=false
