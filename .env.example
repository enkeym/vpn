DATABASE_URL="./sqlite.db"
PORT=3000

TELEGRAM_BOT_TOKEN= # Можно получить в @BotFather
TELEGRAM_ALLOWED_IDS= # 12345678,87654321 Добавь свой telegramId @Getmyid_bot

WG_ADDRESS= # 10.0.0
WG_DNS=1.1.1.1,8.8.8.8
WG_MTU= # 1420 шина приема
WG_ALLOWED_IPS= # 0.0.0.0/0,::/0
WG_HOST= # 11.111.111.111
WG_PORT= # внутрь требуется 51820
WG_CONF_PATH= # путь для конфигов

# === AmneziaWG (обфусцированный WireGuard на отдельном интерфейсе awg0) ===
# Поднимается автоматически, если в образе есть awg/awg-quick/amneziawg-go.
AWG_ENABLED=true # false — не поднимать awg0 и не предлагать его в боте
AWG_PORT=51821 # UDP-порт awg0, обязан отличаться от WG_PORT
AWG_ADDRESS=10.9.0.1/16 # своя подсеть, не пересекающаяся с wg0 (10.8.0.0/16)
AWG_MTU=1280 # junk-пакеты увеличивают размер, поэтому MTU ниже, чем у WG

# Параметры обфускации. Если не заданы — генерируются один раз при создании
# configs/awg0.conf (уникальные для сервера — так лучше против DPI).
# Задавать нужно ЛИБО все девять, ЛИБО ни одного. Ограничение: AWG_S1 + 56 != AWG_S2,
# AWG_H1..AWG_H4 различны и больше 4.
AWG_JC= # кол-во мусорных пакетов, 1..128
AWG_JMIN= # мин. размер мусорного пакета
AWG_JMAX= # макс. размер мусорного пакета (<= 1280)
AWG_S1= # добивка init-пакета хендшейка
AWG_S2= # добивка response-пакета хендшейка
AWG_H1= # подменённые типы заголовков
AWG_H2=
AWG_H3=
AWG_H4=

# Опционально, AmneziaWG 1.5 (нужен свежий AmneziaVPN у клиента).
# Значения копируются в конфиг как есть, синтаксис — из документации Amnezia.
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=
AWG_J1=
AWG_J2=
AWG_J3=
AWG_ITIME=

YOOKASSA_SHOP_ID=#ваш_id
YOOKASSA_SECRET_KEY=#ваш_ключ
TELEGRAM_BOT_USERNAME=tunelvpnbot # без @
INTERNAL_METRICS_KEY= # ключ для доступа к метрикам

# true — все платежи в ЮKassa на 1 ₽; доступен POST /payment/test/complete-succeeded (имитация успеха без вебхука)
TEST_PAYMENT=false

# true — скрыть меню оплаты (и кнопку «Получить VPN») для обычных пользователей. Админов и «Семью» не затрагивает.
HIDE_USER_PAYMENT_MENU=false